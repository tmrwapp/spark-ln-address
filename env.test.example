# Test Database Configuration
# This file is optional - the test setup will use these defaults if .env.test doesn't exist
DATABASE_URL="mysql://spark_user:spark_password@localhost:3309/spark_ln_address_test"

# Public API Configuration
PUBLIC_BASE_URL="http://localhost:3003"
PORT=3003

# Flashnet orchestration
# Leave FLASHNET_API_KEY empty in test env — the mock service activates when the key is absent
FLASHNET_API_BASE=https://orchestration.flashnet.xyz
FLASHNET_API_KEY=
FLASHNET_WEBHOOK_SECRET=
# ── Auth ─────────────────────────────────────────────────────────────────────
# Maximum allowed clock skew (ms) for X-Auth-Timestamp on signed requests.
AUTH_MAX_SKEW_MS=60000

# ── USDB kill switch ──────────────────────────────────────────────────────────
# Keep false in test env unless specifically testing the USDB path.
USDB_ENABLED=false

# ── Ops endpoints (refund cases, future: secret rotation) ────────────────────
# Leave empty in test env unless specifically testing the ops endpoint auth.
INTERNAL_OPS_TOKEN=

