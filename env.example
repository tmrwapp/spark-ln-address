# MySQL Docker container credentials (used by docker-compose.prod.yml)
# Use strong, unique passwords for production
MYSQL_ROOT_PASSWORD="your_strong_root_password"
MYSQL_PASSWORD="your_strong_password"

# Database connection (for Docker MySQL) - uses MYSQL_PASSWORD variable to avoid defining password twice
DATABASE_URL="mysql://spark_user:${MYSQL_PASSWORD}@localhost:3306/spark_ln_address"

# Public API URL (must match your domain)
PUBLIC_BASE_URL="https://yourdomain.com"

# Port (default: 3003)
PORT=3003

# Flashnet orchestration
# FLASHNET_API_KEY absence activates the mock client (safe for development without credentials)
FLASHNET_API_BASE=https://orchestration.flashnet.xyz
FLASHNET_API_KEY=
FLASHNET_WEBHOOK_SECRET=
# ── Auth ─────────────────────────────────────────────────────────────────────
# Maximum allowed clock skew (ms) for X-Auth-Timestamp on signed requests.
# Non-numeric or non-positive values are rejected at startup with a warning
# and the default (60000) is used instead.
AUTH_MAX_SKEW_MS=60000

# ── USDB kill switch ──────────────────────────────────────────────────────────
# Set to "true" to activate the USDB onramp path for users with
# defaultReceivingCurrency=USDB. When "false" (default), all users receive
# SATS regardless of their preference. Flip to "true" only after the rollout
# gate checklist in default-receiving-currency.md §11 is green.
USDB_ENABLED=false
