// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReceivingCurrency {
  SATS
  USDB
}

model User {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  defaultReceivingCurrency ReceivingCurrency @default(USDB)
  // Extra username changes granted by support, on top of the default allowance.
  // Raises the ceiling only; usage stays derived from the LightningName row count.
  bonusUsernameChanges Int @default(0)

  // Relations
  lightningNames LightningName[]

  @@map("users")
}

model LightningName {
  id                  String  @id @default(cuid(2))
  username            String  @unique
  userId              String
  linkingPubKeyHex    String  // secp256k1 public key hex for LNURL-Auth
  active              Boolean @default(true)
  // Mirror of linkingPubKeyHex while the row is active, NULL once retired.
  // MySQL allows repeated NULLs in a unique index, so this enforces
  // "at most one active name per pubkey" while permitting unlimited retired
  // rows. Always written in the same statement that flips `active`.
  activePubKey        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([activePubKey])
  @@index([linkingPubKeyHex])
  @@index([userId])
  @@map("lightning_names")
}

model AuthNonce {
  id           String   @id @default(cuid(2))
  k1           String   @unique // 32-byte hex nonce for LNURL-Auth
  expiresAt    DateTime
  usedAt       DateTime?
  metadataJson String? // optional JSON metadata from wallet

  @@map("auth_nonces")
}

model Invoice {
  id          String   @id @default(cuid(2))
  usernameId  String
  amountMsat  BigInt   // amount in milli-satoshi
  bolt11      String   @db.Text // BOLT11 invoice string
  createdAt   DateTime @default(now())
  expiresAt   DateTime // when invoice expires
  status      String   @default("pending") // pending, paid, expired, cancelled
  receivingCurrency ReceivingCurrency @default(USDB)
  destinationSparkAddress String?

  // Relations
  lightningName LightningName @relation(fields: [usernameId], references: [id], onDelete: Cascade)
  flashnetOrder FlashnetOrder?
  refundCase    RefundCase?

  @@map("invoices")
}

model FlashnetOrder {
  id                        String    @id @default(cuid(2))
  invoiceId                 String    @unique
  quoteId                   String?   @unique
  orderId                   String?   @unique
  lightningReceiveRequestId String?   @unique
  estimatedOut              Decimal?  @db.Decimal(38, 8)
  lockedMinAmountOut        Decimal?  @db.Decimal(38, 8)
  actualOut                 Decimal?  @db.Decimal(38, 8)
  feeAmount                 Decimal?  @db.Decimal(38, 8)
  roundingFeeAmount         Decimal?  @db.Decimal(38, 8)
  totalFeeAmount            Decimal?  @db.Decimal(38, 8)
  feeBps                    Int?
  feeAsset                  String?
  route                     String?   @db.Text
  priceLockMode             String?
  status                    String?
  errorCode                 String?
  errorMessage              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("flashnet_orders")
}

model FlashnetWebhookEvent {
  id          String    @id @default(cuid(2))
  orderId     String
  event       String
  timestamp   BigInt
  rawBody     String    @db.Text
  signature   String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orderId, event, timestamp])
  @@index([orderId])
  @@map("flashnet_webhook_events")
}

model RefundCase {
  id             String    @id @default(cuid(2))
  invoiceId      String    @unique
  amountSats     Int
  reason         String
  externalRef    String?
  payeeLnAddress String?
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("refund_cases")
}
